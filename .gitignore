# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!admin/.env.example

# local product image dumps
/public/products/
/public/final_products_combined/

# large local media (hosted elsewhere / not needed in git)
*.mp4
*.webm
*.mov
/*.pdf
/public/flower-frames/
/public/images/
/public/categories/
/public/hero/
_git_trace.log
**/_git_trace.log
*.lnk
/_size_report.txt
docs/*.xlsx
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
